<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TV Home updates from GitHub, installed with Android's installer after the user confirms. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Bell: Bluetooth devices connecting / disconnecting. BLUETOOTH alone is enough up to
         Android 11; 12+ needs the runtime permission below for names and the ACL broadcasts, and
         MainActivity asks for it at start (a TV without Bluetooth just never asks). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Running-apps screen: close background apps when USB debugging is off. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Phone remote: a foreground service keeps the HTTP server alive; the overlay permission
         shows the pairing PIN and lets it open apps while another app is on screen.
         Android 14+ (targetSdk 34+) requires the permission for the declared service type
         (connectedDevice) and a runtime prerequisite for it; without them startForeground()
         throws SecurityException. CHANGE_NETWORK_STATE is the prerequisite (normal permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 13+: updating the phone-remote notification. The launcher doesn't prompt for it,
         so without the grant RemoteService simply skips the update; the foreground notification
         startForeground shows is not affected. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone remote Files tab: browse, upload and download the TV's storage. On Android 10
         READ/WRITE plus requestLegacyExternalStorage give plain file access; both are granted
         over ADB by build-and-install.sh. On Android 11+ those are ignored and "All files
         access" (MANAGE_EXTERNAL_STORAGE, also granted over ADB) is what keeps the Files tab,
         the Wallpapers folder and reading the screenshot file working. The app is sideloaded,
         so Play's scoped-storage policy doesn't apply. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Bell: apps with an update waiting, from the Play Store's log lines (PlayUpdates). A
         development permission, granted over ADB like DUMP; only used below Android 13. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Now Playing card without USB debugging: read `dumpsys media_session`. A development
         permission, granted over ADB by build-and-install.sh. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 10 only reveals the Wi-Fi network name to apps holding location permission.
         build-and-install.sh grants it over ADB; without it the pill just says "Wi-Fi". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Most used" card and usage-sorted grid. Granted over ADB by build-and-install.sh
         (appops GET_USAGE_STATS); without it the card says how to grant it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: without these the app grid comes up empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/channel" />
        </intent>
        <!-- Phone remote "Open on TV": find players/viewers for a file type. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_home"
        android:banner="@drawable/banner"
        android:theme="@style/HomeTheme"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/UpdateTheme" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".RemoteAccessibilityService"
            android:exported="true"
            android:label="@string/remote_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_accessibility" />
        </service>
    </application>
</manifest>
